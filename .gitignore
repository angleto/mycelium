# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.eggs/
build/
dist/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Env / secrets
.env
.env.*
envtest
envtest.*
*.local
web/e2e-prod/.auth/

# Local-only material (out-of-band keys, CSRs, scratch credentials).
# Anything dropped under /private/ never enters git history.
/private/

# Defensive: private keys and key bundles never go in the repo, no
# matter where they land. Public certs (.crt) are intentionally left
# trackable.
*.key
*.pem
*.csr
*.p12
*.pfx

# Defensive: electronic-invoice files and SdI receipts, wherever they
# land. The SdI names them <IdPaese><IdCodice>_<progressivo>.xml, plus a
# _RC_/_NS_/_MC_/_NE_/_MT_/_DT_/_AT_/_EC_ variant per receipt kind.
# THIS REPOSITORY IS PUBLIC: the filename alone carries the transmitter's
# fiscal identifier, and a receipt carries the IdentificativoSdI, the
# MessageId and the delivery timestamps. Committing one publishes it
# irreversibly -- a later removal does not erase it from the history.
# (Two RC receipts were caught by `git add -A` once; this is the guard.)
IT*_*.xml

# Node / web
node_modules/
web/dist/
web/.vite/

# OS / editor
.DS_Store
*.swp

# Local working files dropped in the repo root: PDFs we read for spec
# or invoice samples, and Claude Code's per-session metadata. Never
# part of the project.
*.pdf
.claude/
