# Supply-chain policy: refuse packages whose latest version is less than
# 12h old. Lower than pnpm v11's default 24h so that a legitimate same-
# day dependency upgrade (e.g. a day-of TipTap patch) does not block
# the build, but tight enough to still catch a same-hour typo-squat or
# brand-new compromised release.
minimum-release-age=12h
# Long-stable math-typesetting deps (rare releases, well-known authors).
# The 12h gate would just block their install without adding safety.
# @xyflow/react: garden mindmap graph rendering (ADR-0029 P2). Maintained
# by xyflow GmbH, MIT, predictable release cadence; exempted explicitly
# because the policy parser in pnpm 10.x reads "12h" wrongly and blocks
# even well-aged versions.
minimum-release-age-exclude[]=remark-math
minimum-release-age-exclude[]=remark-gfm
minimum-release-age-exclude[]=rehype-katex
minimum-release-age-exclude[]=katex
minimum-release-age-exclude[]=@xyflow/react
