# Supply-chain policy: refuse packages whose latest version is less than
# 12h old. Lower than pnpm v11's default 1d so that legitimate new
# dependency upgrades (e.g. day-of TipTap patches we depend on) don't
# block the build, but tight enough to catch a same-hour typo-squat /
# brand-new compromised release.
min-release-age=12h
