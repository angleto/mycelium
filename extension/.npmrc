# Same supply-chain policy as web/: refuse a package whose latest version
# is less than 12h old, which catches a same-hour typo-squat or a brand-new
# compromised release without blocking a legitimate same-day upgrade.
#
# This package carries its own copy rather than inheriting one, for the
# same reason it carries its own lockfile: it is not a workspace member.
# The exemption list is deliberately EMPTY here -- the extension has no
# runtime dependencies at all, so there is nothing to exempt, and an
# entry appearing in this file later is a signal worth reading.
minimum-release-age=12h
