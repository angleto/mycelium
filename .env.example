# Copia in .env e adatta. Tutte le variabili sono prefissate FLOW_.

# Database (asyncpg)
FLOW_DATABASE_URL=postgresql+asyncpg://flow:flow@localhost:5432/flow
# URL sincrono usato da Alembic
FLOW_DATABASE_URL_SYNC=postgresql+psycopg://flow:flow@localhost:5432/flow

# Redis
FLOW_REDIS_URL=redis://localhost:6379/0

# Auth
FLOW_JWT_SECRET=change-me-in-prod
FLOW_JWT_ALG=HS256
FLOW_JWT_TTL_SECONDS=3600

# App
FLOW_ENV=dev
FLOW_LOG_LEVEL=INFO
