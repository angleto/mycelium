# Copy to .env and adapt. All variables are prefixed MYCELIUM_.

# Database. The app connects as the runtime role flow_app (subject to
# RLS, see docs/adr/0015). Migrations as the owner flow.
MYCELIUM_DATABASE_URL=postgresql+asyncpg://flow_app:flow_app@localhost:5432/flow
MYCELIUM_DATABASE_URL_SYNC=postgresql+psycopg://flow:flow@localhost:5432/flow
# Runtime role password, used by `make db-bootstrap` (dev value).
MYCELIUM_DB_APP_PASSWORD=flow_app

# Redis
MYCELIUM_REDIS_URL=redis://localhost:6379/0

# Auth
MYCELIUM_JWT_SECRET=dev-only-change-me-min-32-bytes-secret-0001
MYCELIUM_JWT_ALG=HS256
# Fernet key for the opaque-secret envelope (urlsafe-b64 of 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MYCELIUM_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MYCELIUM_JWT_TTL_SECONDS=3600

# SdI electronic invoicing (ADR-0011, FR-9). Default "manual_export":
# Mycelium builds the FatturaPA XML for download and the tenant submits it.
# Set "sdicoop" to transmit through Mycelium's accredited channel as
# intermediary (requires AdE accreditation + the certs/endpoint below and a
# per-issuer SdiMandate). MYCELIUM_SDI_* below are required only when sdicoop
# (validated fail-closed at startup).
MYCELIUM_SDI_CHANNEL=manual_export
# Accredited-channel (intermediary) identity stamped into IdTrasmittente +
# TerzoIntermediarioOSoggettoEmittente. id_codice = the channel holder P.IVA.
MYCELIUM_SDI_INTERMEDIARY_ID_PAESE=IT
MYCELIUM_SDI_INTERMEDIARY_ID_CODICE=
MYCELIUM_SDI_INTERMEDIARY_DENOMINAZIONE=
# SdICoop RiceviFile endpoint + mutual-TLS client cert/key (PEM paths);
# CA bundle optional (system trust store otherwise).
MYCELIUM_SDI_ENDPOINT_URL=
MYCELIUM_SDI_CLIENT_CERT=
MYCELIUM_SDI_CLIENT_KEY=
MYCELIUM_SDI_CA_BUNDLE=

# App
MYCELIUM_ENV=dev
MYCELIUM_LOG_LEVEL=INFO
