# Copy to .env and adapt. All variables are prefixed FLOW_.

# Database. The app connects as the runtime role flow_app (subject to
# RLS, see docs/adr/0015). Migrations as the owner flow.
FLOW_DATABASE_URL=postgresql+asyncpg://flow_app:flow_app@localhost:5432/flow
FLOW_DATABASE_URL_SYNC=postgresql+psycopg://flow:flow@localhost:5432/flow
# Runtime role password, used by `make db-bootstrap` (dev value).
FLOW_DB_APP_PASSWORD=flow_app

# Redis
FLOW_REDIS_URL=redis://localhost:6379/0

# Auth
FLOW_JWT_SECRET=dev-only-change-me-min-32-bytes-secret-0001
FLOW_JWT_ALG=HS256
# Fernet key for the opaque-secret envelope (urlsafe-b64 of 32 bytes).
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FLOW_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FLOW_JWT_TTL_SECONDS=3600

# SdI electronic invoicing (ADR-0011, FR-9). Default "manual_export":
# Flow builds the FatturaPA XML for download and the tenant submits it.
# Set "sdicoop" to transmit through Flow's accredited channel as
# intermediary (requires AdE accreditation + the certs/endpoint below and a
# per-issuer SdiMandate). FLOW_SDI_* below are required only when sdicoop
# (validated fail-closed at startup).
FLOW_SDI_CHANNEL=manual_export
# Accredited-channel (intermediary) identity stamped into IdTrasmittente +
# TerzoIntermediarioOSoggettoEmittente. id_codice = the channel holder P.IVA.
FLOW_SDI_INTERMEDIARY_ID_PAESE=IT
FLOW_SDI_INTERMEDIARY_ID_CODICE=
FLOW_SDI_INTERMEDIARY_DENOMINAZIONE=
# SdICoop RiceviFile endpoint + mutual-TLS client cert/key (PEM paths);
# CA bundle optional (system trust store otherwise).
FLOW_SDI_ENDPOINT_URL=
FLOW_SDI_CLIENT_CERT=
FLOW_SDI_CLIENT_KEY=
FLOW_SDI_CA_BUNDLE=

# App
FLOW_ENV=dev
FLOW_LOG_LEVEL=INFO
